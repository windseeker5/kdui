{
  "name": "kd-ui",
  "version": "0.3.0",
  "private": true,
  "description": "Build packaged Tailwind CSS and Basecoat assets for KD UI.",
  "scripts": {
    "sync:basecoat": "node scripts/sync_basecoat.mjs",
    "build:css": "tailwindcss -i ./src/kdui/static/kdui/css/input.css -o ./src/kdui/static/kdui/css/output.css --minify",
    "watch:css": "tailwindcss -i ./src/kdui/static/kdui/css/input.css -o ./src/kdui/static/kdui/css/output.css --watch",
    "build": "npm run sync:basecoat && npm run build:css",
    "postinstall": "npm run build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "basecoat-css": "^1.0.2"
  }
}
